{
  "name": "controlled-office-assistant",
  "private": true,
  "packageManager": "pnpm@10.6.0",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "pnpm --filter @office/web dev",
    "dev:api": "cd backend && uvicorn app.main:app --reload"
  }
}
